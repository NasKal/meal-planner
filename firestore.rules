rules_version = '2';

// Κανόνες ασφαλείας Meal Planner.
// Κάθε μέλος νοικοκυριού διαβάζει και γράφει μόνο στα δεδομένα του νοικοκυριού του.
// Η συμμετοχή γίνεται με μοναδικό κωδικό πρόσκλησης (invites/{code}), χωρίς Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in get(householdPath(hid)).data.memberIds;
    }

    function inviteIsValid(hid, code) {
      let path = /databases/$(database)/documents/invites/$(code);
      return exists(path)
        && get(path).data.householdId == hid
        && get(path).data.expiresAt > request.time;
    }

    // Προφίλ χρήστη: μόνο ο ίδιος.
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /households/{hid} {
      allow read: if isMember(hid);

      // Δημιουργία: ο δημιουργός είναι το μοναδικό μέλος.
      allow create: if signedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      // Ενημέρωση από μέλος: η λίστα μελών δεν αλλάζει.
      allow update: if isMember(hid)
        && request.resource.data.memberIds == resource.data.memberIds;

      // Συμμετοχή με έγκυρο κωδικό: προστίθεται μόνο ο ίδιος ο χρήστης.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinCode'])
        && inviteIsValid(hid, request.resource.data.joinCode);

      allow delete: if false;
    }

    // Κωδικοί πρόσκλησης: διαβάζονται μόνο όταν είναι γνωστός ο κωδικός (όχι λίστα).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // Διαγραφή από μέλος, ή από όποιον γίνεται μέλος στο ίδιο batch (getAfter).
      allow delete: if signedIn() && (
        request.auth.uid in get(householdPath(resource.data.householdId)).data.memberIds
        || request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.memberIds
      );

      allow update: if false;
    }

    // Δεδομένα νοικοκυριού, μόνο γνωστές υποσυλλογές.
    match /households/{hid}/{sub}/{docId} {
      allow read, write: if isMember(hid)
        && sub in ['stores', 'dishes', 'plan', 'extras', 'checks', 'pantry', 'manualItems', 'prices'];
    }
  }
}
